extends base

block content
  div(class='max-w-7xl mx-auto flex flex-col lg:flex-row min-h-[calc(100vh-80px)] pt-20')
    //- Sidebar
    aside(class='flex flex-col lg:flex-col h-auto py-4 lg:py-8 space-y-4 lg:space-y-2 bg-white dark:bg-zinc-900 w-full lg:w-64 border-b lg:border-b-0 lg:border-r border-zinc-200 dark:border-zinc-800 font-serif text-sm font-medium')
      div.px-6.hidden.lg:block.mb-8
        p(class='text-lg font-black text-zinc-900 dark:text-white') Account Central
        p(class='text-xs text-zinc-500 dark:text-zinc-400 font-sans uppercase tracking-widest mt-1') Natours Member

      nav(class='flex-1 px-3 flex flex-row lg:flex-col overflow-x-auto lg:overflow-visible space-x-2 lg:space-x-0 lg:space-y-1 pb-2 lg:pb-0 scrollbar-hide')
        a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300 lg:border-r-4 border-b-2 lg:border-b-0 border-emerald-600 transition-all duration-300 ease-in-out lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/me')
          span.material-symbols-outlined.text-lg lg:text-xl person
          | Settings
        a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-all duration-300 ease-in-out lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/my-tours')
          span.material-symbols-outlined.text-lg lg:text-xl luggage
          | My Bookings
        a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-all duration-300 ease-in-out lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/my-reviews')
          span.material-symbols-outlined.text-lg lg:text-xl rate_review
          | My Reviews
        a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-all duration-300 ease-in-out lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/my-favourites')
          span.material-symbols-outlined.text-lg lg:text-xl favorite
          | Favourites

        if user.role === 'admin' || user.role === 'lead-guide'
          div(class='hidden lg:block border-t border-zinc-200 my-4 mx-4')
          a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 transition-all lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/manage-tours')
            span.material-symbols-outlined.text-lg lg:text-xl map
            | Manage Tours
          a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 transition-all lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/manage-users')
            span.material-symbols-outlined.text-lg lg:text-xl group
            | Manage Users
          a(class='nav__el flex whitespace-nowrap items-center gap-2 lg:gap-3 px-4 py-2 lg:py-3 text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 transition-all lg:hover:translate-x-1 rounded-lg lg:rounded-none no-underline' href='/manage-reviews')
            span.material-symbols-outlined.text-lg lg:text-xl reviews
            | Manage Reviews

    //- Main Content
    main(class='flex-1 bg-surface-container-low p-margin md:p-section-padding overflow-y-auto')
      div(class='max-w-4xl mx-auto space-y-10')
        //- Header
        div.space-y-2
          h1(class='text-headline-xl font-headline-xl text-on-surface') Personal Info
          p(class='text-body-lg font-body-lg text-on-surface-variant max-w-2xl') Manage your expedition identity and preferences.

        //- Profile Card
        div(class='grid grid-cols-1 md:grid-cols-3 gap-gutter')
          div(class='md:col-span-2 bg-white dark:bg-zinc-800 rounded-xl p-6 shadow-sm border border-zinc-100 dark:border-zinc-700 flex items-center gap-6')
            div.relative.group
              div(class='h-24 w-24 rounded-full overflow-hidden border-4 border-primary-container/30')
                img(class='w-full h-full object-cover' src=`/img/users/${user.photo}` alt=`${user.name}`)
            div
              h3(class='text-headline-md font-headline-md text-on-surface')= user.name
              p(class='text-body-md font-body-md text-on-surface-variant')= user.email
              div(class='mt-2 flex gap-2')
                span(class='bg-primary-container text-on-primary-container px-3 py-1 rounded-full text-label-sm font-label-sm uppercase')= user.role

        //- Account Details Card
        section(class='bg-white dark:bg-zinc-800 rounded-xl shadow-sm border border-zinc-100 dark:border-zinc-700 overflow-hidden')
          div(class='px-8 py-6 border-b border-zinc-100 dark:border-zinc-700')
            h2(class='text-headline-md font-headline-md text-on-surface') Account Details
          div.p-8
            form(class='form form-user-data grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8')
              div.space-y-1
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase' for='name') Full Name
                input#name(class='w-full border-b border-zinc-200 dark:border-zinc-600 py-2 focus:border-primary outline-none text-body-md font-body-md bg-transparent text-on-surface' type='text' value=`${user.name}` required)
              div.space-y-1
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase' for='email') Email Address
                input#email(class='w-full border-b border-zinc-200 dark:border-zinc-600 py-2 focus:border-primary outline-none text-body-md font-body-md bg-transparent text-on-surface' type='email' value=`${user.email}` required)
              div(class='space-y-1 md:col-span-2')
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase') Photo
                div(class='flex items-center gap-4')
                  img(class='w-12 h-12 rounded-full object-cover' src=`/img/users/${user.photo}` alt='User photo')
                  input(class='text-body-md file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary-container file:text-on-primary-container hover:file:bg-primary-fixed cursor-pointer' type='file' accept='image/*' id='photo' name='photo')
              div(class='md:col-span-2 flex justify-end')
                button(class='btn--save-settings bg-primary-container text-on-primary-container font-label-lg px-8 py-3 rounded-lg shadow-sm hover:shadow-md hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer border-none' type='submit') Save Settings

        //- Password Card
        section(class='bg-white dark:bg-zinc-800 rounded-xl shadow-sm border border-zinc-100 dark:border-zinc-700 overflow-hidden')
          div(class='px-8 py-6 border-b border-zinc-100 dark:border-zinc-700')
            h2(class='text-headline-md font-headline-md text-on-surface') Change Password
          div.p-8
            form(class='form form-user-password space-y-8')
              div.space-y-1
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase' for='password-current') Current Password
                input#password-current(class='w-full border-b border-zinc-200 dark:border-zinc-600 py-2 focus:border-primary outline-none text-body-md font-body-md bg-transparent text-on-surface' type='password' placeholder='••••••••' required minlength='8')
              div.space-y-1
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase' for='password') New Password
                input#password(class='w-full border-b border-zinc-200 dark:border-zinc-600 py-2 focus:border-primary outline-none text-body-md font-body-md bg-transparent text-on-surface' type='password' placeholder='••••••••' required minlength='8')
              div.space-y-1
                label(class='text-label-lg font-label-lg text-on-surface-variant uppercase' for='password-confirm') Confirm Password
                input#password-confirm(class='w-full border-b border-zinc-200 dark:border-zinc-600 py-2 focus:border-primary outline-none text-body-md font-body-md bg-transparent text-on-surface' type='password' placeholder='••••••••' required minlength='8')
              div(class='flex justify-end')
                button(class='btn--save-password bg-secondary text-on-secondary font-label-lg px-8 py-3 rounded-lg shadow-sm hover:shadow-md hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer border-none' type='submit') Update Password
