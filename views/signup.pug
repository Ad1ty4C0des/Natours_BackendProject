extends base

block content
  main(class='flex-grow flex items-center justify-center pt-20 px-4 relative overflow-hidden bg-surface-bright')
    //- Aesthetic Background Elements
    div(class='absolute top-0 left-0 w-full h-full opacity-5 pointer-events-none')
      div(class='absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-primary rounded-full blur-[120px]')
      div(class='absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px] bg-secondary rounded-full blur-[120px]')
    //- Signup Card
    section(class='w-full max-w-md relative z-10 py-section-padding')
      div(class='bg-surface-container-lowest rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-outline-variant/30 overflow-hidden')
        //- Card Header
        div(class='p-8 pb-0 text-center')
          h1(class='font-headline-lg text-headline-lg text-on-surface mb-2') Join the Adventure
          p(class='font-body-md text-body-md text-on-surface-variant') Create your premium explorer account
        //- Form Content
        div.p-8
          form(class='form form--signup space-y-5')
            //- Name
            div.space-y-2
              label(class='font-label-lg text-label-lg text-on-surface-variant block uppercase tracking-wider' for='name') Full Name
              div.relative
                span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline') person
                input#name(class='w-full pl-12 pr-4 py-3.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface placeholder:text-outline/60' type='text' placeholder='Your full name' required)
            //- Email
            div.space-y-2
              label(class='font-label-lg text-label-lg text-on-surface-variant block uppercase tracking-wider' for='email') Email Address
              div.relative
                span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline') mail
                input#email(class='w-full pl-12 pr-4 py-3.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface placeholder:text-outline/60' type='email' placeholder='explorer@natours.com' required)
            //- Password
            div.space-y-2
              label(class='font-label-lg text-label-lg text-on-surface-variant block uppercase tracking-wider' for='password') Password
              div.relative
                span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline') lock
                input#password(class='w-full pl-12 pr-4 py-3.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface placeholder:text-outline/60' type='password' placeholder='••••••••' required minlength='8')
            //- Password Confirm
            div.space-y-2
              label(class='font-label-lg text-label-lg text-on-surface-variant block uppercase tracking-wider' for='password-confirm') Confirm Password
              div.relative
                span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline') lock
                input#password-confirm(class='w-full pl-12 pr-4 py-3.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all font-body-md text-on-surface placeholder:text-outline/60' type='password' placeholder='••••••••' required minlength='8')
            //- Signup Button
            div.pt-2
              button(class='btn--signup w-full bg-primary-container text-on-primary-container font-label-lg text-body-lg py-4 rounded-lg shadow-md hover:shadow-lg hover:brightness-110 active:scale-[0.98] transition-all flex items-center justify-center gap-2' type='submit')
                | Create Account
                span.material-symbols-outlined arrow_forward
        //- Card Footer
        div(class='bg-surface-container-high p-6 text-center border-t border-outline-variant/30')
          p(class='font-body-md text-on-surface-variant')
            | Already have an account? 
            a(class='text-primary font-semibold hover:underline' href='/login') Log in
