extends base

include _reviewCard

block content
  main.flex-grow.pt-20
    section(class='py-section-padding px-8 max-w-[1280px] mx-auto')
      div.mb-12
        a(class='text-primary font-label-lg hover:underline flex items-center gap-1 mb-6 no-underline' href=`/tour/${tour.slug}`)
          span.material-symbols-outlined arrow_back
          | Back to #{tour.name}
        h1(class='font-headline-xl text-headline-xl text-on-surface mb-2') Reviews
        p(class='font-body-lg text-on-surface-variant')= `${tour.reviews.length} reviews for ${tour.name}`

      div(class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter')
        each review in tour.reviews
          +reviewCard(review)
