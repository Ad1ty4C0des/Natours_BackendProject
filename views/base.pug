doctype html
html(lang='en')
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(name='description' content='Natours — Premium adventure tours through the world\'s most breathtaking landscapes')
      script(src='https://cdn.tailwindcss.com?plugins=forms,container-queries')
      link(rel='preconnect' href='https://fonts.googleapis.com')
      link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
      link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap')
      link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap')
      link(rel='stylesheet' href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css')
      script(src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js')
      link(rel='stylesheet' href='/css/style.css')
      link(rel='shortcut icon' type='image/png' href='/img/favicon.png')
      title Natours | #{title}
      //- Apply dark mode BEFORE render to prevent flash
      script.
        (function() {
          var t = localStorage.getItem('natours-theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        })();
      script(id='tailwind-config').
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "on-surface-variant": "var(--c-on-surface-variant, #3e4a3f)",
                "on-secondary": "#ffffff",
                "surface-dim": "var(--c-surface-dim, #dadada)",
                "tertiary-fixed": "#e4e2e2",
                "tertiary-container": "#b1afaf",
                "surface-tint": "#006d37",
                "surface-variant": "var(--c-surface-variant, #e2e2e2)",
                "on-secondary-container": "#651b00",
                "primary": "#006d37",
                "surface": "var(--c-surface, #f9f9f9)",
                "background": "var(--c-bg, #f9f9f9)",
                "primary-container": "#55c57a",
                "on-primary": "#ffffff",
                "on-primary-fixed-variant": "#005228",
                "error": "#ba1a1a",
                "on-tertiary-fixed": "#1b1c1c",
                "on-tertiary-container": "#434343",
                "secondary": "#a8390d",
                "secondary-container": "#fc7647",
                "on-primary-container": "#004e25",
                "inverse-surface": "#2f3131",
                "surface-container-lowest": "var(--c-sc-lowest, #ffffff)",
                "on-tertiary-fixed-variant": "#474747",
                "tertiary": "#5f5e5e",
                "surface-bright": "var(--c-surface-bright, #f9f9f9)",
                "primary-fixed-dim": "#6ddd8f",
                "on-background": "var(--c-on-bg, #1a1c1c)",
                "outline": "#6e7a6e",
                "surface-container": "var(--c-sc, #eeeeee)",
                "on-error": "#ffffff",
                "primary-fixed": "#89faa9",
                "secondary-fixed-dim": "#ffb59d",
                "on-secondary-fixed": "#390c00",
                "on-primary-fixed": "#00210c",
                "on-error-container": "#93000a",
                "on-surface": "var(--c-on-surface, #1a1c1c)",
                "secondary-fixed": "#ffdbd0",
                "surface-container-highest": "var(--c-sc-highest, #e2e2e2)",
                "outline-variant": "var(--c-outline-variant, #bdcabc)",
                "inverse-on-surface": "#f1f1f1",
                "surface-container-low": "var(--c-sc-low, #f3f3f3)",
                "error-container": "#ffdad6",
                "surface-container-high": "var(--c-sc-high, #e8e8e8)",
                "tertiary-fixed-dim": "#c8c6c6",
                "inverse-primary": "#6ddd8f",
                "on-secondary-fixed-variant": "#832600",
                "on-tertiary": "#ffffff"
              },
              borderRadius: {
                DEFAULT: "0.25rem",
                lg: "0.5rem",
                xl: "0.75rem",
                full: "9999px"
              },
              spacing: {
                "section-padding": "80px",
                base: "8px",
                margin: "32px",
                gutter: "24px",
                "container-max": "1280px"
              },
              fontFamily: {
                "headline-xl": ["Noto Serif"],
                "label-lg": ["Plus Jakarta Sans"],
                "headline-lg": ["Noto Serif"],
                "body-lg": ["Plus Jakarta Sans"],
                "body-md": ["Plus Jakarta Sans"],
                "headline-md": ["Noto Serif"],
                "label-sm": ["Plus Jakarta Sans"]
              },
              fontSize: {
                "headline-xl": ["48px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
                "label-lg": ["14px", { lineHeight: "1.2", letterSpacing: "0.05em", fontWeight: "600" }],
                "headline-lg": ["36px", { lineHeight: "1.2", fontWeight: "700" }],
                "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "400" }],
                "body-md": ["16px", { lineHeight: "1.6", fontWeight: "400" }],
                "headline-md": ["28px", { lineHeight: "1.3", fontWeight: "600" }],
                "label-sm": ["12px", { lineHeight: "1.2", fontWeight: "500" }]
              }
            }
          }
        }
      //- Dark mode CSS variables
      style.
        :root {
          --c-bg: #f9f9f9; --c-surface: #f9f9f9; --c-on-bg: #1a1c1c; --c-on-surface: #1a1c1c;
          --c-on-surface-variant: #3e4a3f; --c-surface-dim: #dadada; --c-surface-variant: #e2e2e2;
          --c-sc-lowest: #ffffff; --c-sc: #eeeeee; --c-sc-low: #f3f3f3; --c-sc-high: #e8e8e8;
          --c-sc-highest: #e2e2e2; --c-outline-variant: #bdcabc; --c-surface-bright: #f9f9f9;
        }
        .dark {
          --c-bg: #111313; --c-surface: #111313; --c-on-bg: #e2e2e2; --c-on-surface: #e2e2e2;
          --c-on-surface-variant: #b0bfb0; --c-surface-dim: #111313; --c-surface-variant: #2a2d2a;
          --c-sc-lowest: #0c0e0e; --c-sc: #1d1f1f; --c-sc-low: #171919; --c-sc-high: #272929;
          --c-sc-highest: #323434; --c-outline-variant: #3e4a3e; --c-surface-bright: #111313;
        }

  body(class='bg-background text-on-surface font-body-md min-h-screen flex flex-col transition-colors duration-300' data-alert=`${alert ? alert : ''}`)
    //- Page overlay loader (shows on initial load)
    #page-overlay
      div.spinner
      p.spinner-text Natours

    //- Top progress bar (shows on navigation)
    #page-loader
      div.loader-bar

    //Header
    include _header

    //Content
    block content

    //Footer
    include _footer

    script(src="https://js.stripe.com/v3/")
    script(src='/js/bundle.js')

    //- Loader + Dark mode scripts
    script.
      (function() {
        // === PAGE LOADER ===
        var overlay = document.getElementById('page-overlay');
        var loader = document.getElementById('page-loader');

        // Hide overlay once page is fully loaded
        window.addEventListener('load', function() {
          setTimeout(function() {
            if (overlay) overlay.classList.add('hidden');
          }, 300);
        });

        // Show progress bar on navigation
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a[href]');
          if (!link) return;
          var href = link.getAttribute('href');
          // Skip hash links, javascript, external, new tab, and logout
          if (!href || href.startsWith('#') || href.startsWith('javascript') ||
              href.startsWith('http') || href.startsWith('mailto') ||
              link.target === '_blank' || link.classList.contains('nav__el--logout') ||
              link.classList.contains('heart-btn') || e.ctrlKey || e.metaKey) return;

          if (loader) {
            // Reset animation
            var bar = loader.querySelector('.loader-bar');
            bar.style.animation = 'none';
            bar.offsetHeight; // trigger reflow
            bar.style.animation = '';
            loader.classList.remove('done');
            loader.classList.add('active');
          }
        });

        // Complete the loader when page starts unloading
        window.addEventListener('beforeunload', function() {
          if (loader) {
            loader.classList.add('done');
          }
        });

        // === DARK MODE ===
        var themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', function() {
            var html = document.documentElement;
            var isDark = html.classList.toggle('dark');
            localStorage.setItem('natours-theme', isDark ? 'dark' : 'light');
          });
        }
      })();